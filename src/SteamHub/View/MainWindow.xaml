<Window x:Class="SteamHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SteamHub"
        xmlns:common="clr-namespace:SteamHub.Common"
        xmlns:c="clr-namespace:SteamHub;assembly=SteamHub.Common"
        xmlns:convert="clr-namespace:SteamHub.Convert"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:manager="clr-namespace:SteamHub.Manager"
        mc:Ignorable="d"
        Height="720"
        MinHeight="620"
        Width="1100"
        MinWidth="920"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        x:Name="mainWindowView"
        Title="{Binding AppTitle}"
        Background="#f8fafc"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextElement.Foreground="#1e293b"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="KeyDown">
            <common:InvokeCommandActionEx Command="{Binding MainWindowKeyDownCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <common:InvokeCommandActionEx Command="{Binding MainWindowClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>

        <!-- 亮绿启动按钮样式 -->
        <Style x:Key="SteamPlayButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#16a34a" Offset="0" />
                        <GradientStop Color="#15803d" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#22c55e" Offset="0" />
                                            <GradientStop Color="#16a34a" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#22c55e" BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#14532d" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 切换按钮样式 (简约紫色风格) -->
        <Style x:Key="SteamSwitchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f5f5f5" />
            <Setter Property="Foreground" Value="#673ab7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#e0e0e0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ede7f6" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#d1c4e9" />
                                <Setter Property="Foreground" Value="#512da8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 账号项容器样式 (白色主题，紫色高亮) -->
        <Style x:Key="SteamAccountListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#f5f5f5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#ede7f6" />
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#673ab7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 游戏卡片容器样式 -->
        <Style x:Key="SteamGameListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <materialDesign:DrawerHost IsRightDrawerOpen="{Binding DrawerType, Converter={StaticResource InverseEnumToBooleanConverter}, ConverterParameter=None}">
            <!-- 抽屉区域 (白色主题) -->
            <materialDesign:DrawerHost.RightDrawerContent>
                <Border Width="310" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1,0,0,0">
                    <Grid>
                        <!-- Account Edit -->
                        <Grid Margin="16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DrawerType}" Value="SteamAccount">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header with Close Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditSteamAccountAccount}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#0f172a"
                                               VerticalAlignment="Center" />
                                    <!-- 复制账号快捷按钮 -->
                                    <Button Width="26"
                                            Height="26"
                                            Padding="0"
                                            Margin="8,0,0,0"
                                            ToolTip="复制账号"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding CopySteamAccountCommand}">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="#673ab7" />
                                    </Button>
                                    <!-- 复制密码快捷按钮 -->
                                    <Button Width="26"
                                            Height="26"
                                            Padding="0"
                                            Margin="4,0,0,0"
                                            ToolTip="复制密码"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding CopySteamPasswordCommand}">
                                        <materialDesign:PackIcon Kind="KeyOutline" Width="14" Height="14" Foreground="#673ab7" />
                                    </Button>
                                </StackPanel>
                                <Button Width="28"
                                        Height="28"
                                        Foreground="#64748b"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding CloseEditSteamAccountDrawerCommand}"
                                        ToolTip="关闭">
                                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                                </Button>
                            </Grid>

                            <!-- Edit Info Section -->
                            <StackPanel Grid.Row="1">
                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         materialDesign:HintAssist.Hint="昵称 (必填)"
                                         Foreground="#0f172a"
                                         Text="{Binding EditSteamAccountName}"
                                         Margin="0,0,0,16"
                                         FontSize="14" />
                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         materialDesign:HintAssist.Hint="密码 (选填)"
                                         Foreground="#0f172a"
                                         Text="{Binding EditSteamAccountPassword}"
                                         Margin="0,0,0,16"
                                         FontSize="14" />
                            </StackPanel>

                            <!-- Actions Section -->
                            <StackPanel Grid.Row="3">
                                <Separator Margin="0,0,0,12" Background="#e2e8f0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding ToggleHideSteamAccountCommand}"
                                            CommandParameter="{Binding EditSteamAccountAccount}"
                                            Foreground="#64748b"
                                            Padding="6"
                                            Height="Auto"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="EyeOffOutline" HorizontalAlignment="Center" Width="18" Height="18" Margin="0,0,0,2" />
                                            <TextBlock Text="隐藏" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding SaveSteamAccountCommand}"
                                            Foreground="#673ab7"
                                            Padding="6"
                                            Height="Auto">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="ContentSave" HorizontalAlignment="Center" Width="18" Height="18" Margin="0,0,0,2" />
                                            <TextBlock Text="保存" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Game Edit -->
                        <Grid Margin="16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DrawerType}" Value="SteamGame">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header with Close Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="编辑游戏"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0f172a"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <Button Width="28"
                                        Height="28"
                                        Foreground="#64748b"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding CloseEditSteamGameDrawerCommand}"
                                        ToolTip="关闭">
                                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                                </Button>
                            </Grid>

                            <!-- Edit Info Section -->
                            <StackPanel Grid.Row="1">
                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         materialDesign:HintAssist.Hint="游戏名称 (必填)"
                                         Foreground="#0f172a"
                                         Text="{Binding EditSteamGameName}"
                                         Margin="0,0,0,16"
                                         FontSize="14" />
                            </StackPanel>

                            <!-- Actions Section -->
                            <StackPanel Grid.Row="3">
                                <Separator Margin="0,0,0,12" Background="#e2e8f0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding ToggleHideSteamGameCommand}"
                                            CommandParameter="{Binding EditSteamGameAppId}"
                                            Foreground="#64748b"
                                            Padding="6"
                                            Height="Auto"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="EyeOffOutline" HorizontalAlignment="Center" Width="18" Height="18" Margin="0,0,0,2" />
                                            <TextBlock Text="隐藏" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding SaveSteamGameCommand}"
                                            Foreground="#673ab7"
                                            Padding="6"
                                            Height="Auto">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="ContentSave" HorizontalAlignment="Center" Width="18" Height="18" Margin="0,0,0,2" />
                                            <TextBlock Text="保存" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>


                    </Grid>
                </Border>
            </materialDesign:DrawerHost.RightDrawerContent>

            <!-- ================= 主界面内容 (白色浅色主题) ================= -->
            <Grid Background="#f8fafc">
                <Grid.RowDefinitions>
                    <!-- 顶部标题导航栏 (48px) -->
                    <RowDefinition Height="48" />
                    <!-- 分隔线 -->
                    <RowDefinition Height="1" />
                    <!-- 主体左右分栏内容 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ================= 顶部标题导航栏 ================= -->
                <Grid Grid.Row="0" Background="#ffffff">
                    <!-- 左侧 Logo 与 标签 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <materialDesign:PackIcon Kind="Steam" Width="26" Height="26" Foreground="#673ab7" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="SteamHub" FontSize="16" FontWeight="Bold" Foreground="#212121" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </StackPanel>

                    <!-- 右侧：快捷工具 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">


                        <!-- 刷新数据 -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="重新扫描本地 Steam 账号与游戏清单"
                                Foreground="#673ab7"
                                Padding="8,4"
                                Height="32"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="刷新" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 一键清理 -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding CleanUpCommand}"
                                ToolTip="清理本地已不存在的账号与游戏"
                                Foreground="#673ab7"
                                Padding="8,4"
                                Height="32"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="清理" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- GitHub -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding OpenGitHubCommand}"
                                ToolTip="查看 GitHub 仓库"
                                Foreground="#757575"
                                Padding="4"
                                Height="32"
                                Width="32">
                            <materialDesign:PackIcon Kind="Github" Width="18" Height="18" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 顶部分隔线 -->
                <Separator Grid.Row="1" Background="#e0e0e0" Margin="0" />

                <!-- ================= 主体左右分栏 ================= -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- 左侧账号栏 -->
                        <ColumnDefinition Width="260" MinWidth="220" MaxWidth="340" />
                        <!-- 分割线 -->
                        <ColumnDefinition Width="1" />
                        <!-- 右侧游戏库 -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- *************** 左侧：账号列表 *************** -->
                    <Grid Grid.Column="0" Background="#ffffff">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 账号栏标题 -->
                        <Grid Grid.Row="0" Margin="14,0,10,0">
                            <TextBlock Text="STEAM 账号"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#757575"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 账号列表 (含"所有游戏") -->
                        <ListBox Grid.Row="1"
                                 x:Name="lbAccounts"
                                 dd:DragDrop.IsDragSource="True"
                                 dd:DragDrop.IsDropTarget="True"
                                 dd:DragDrop.DropHandler="{Binding}"
                                 dd:DragDrop.UseDefaultDragAdorner="True"
                                 ItemsSource="{Binding SteamAccounts}"
                                 SelectedItem="{Binding SelectedAccount}"
                                 ItemContainerStyle="{StaticResource SteamAccountListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="56" Background="Transparent">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectSteamAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                        </Grid.InputBindings>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 头像 / 图标 -->
                                        <Grid Grid.Column="0" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- 所有游戏图标 -->
                                            <Border CornerRadius="6" Background="#ede7f6"
                                                    Visibility="{Binding SteamId, Converter={StaticResource IsRealAccountConverter}, ConverterParameter=Inverse}">
                                                <materialDesign:PackIcon Kind="GamepadVariant" Width="22" Height="22" Foreground="#673ab7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- 真实账号头像 -->
                                            <Border CornerRadius="6" Background="#fafafa" BorderBrush="#eeeeee" BorderThickness="1"
                                                    Visibility="{Binding SteamId, Converter={StaticResource IsRealAccountConverter}}">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="Account" Width="22" Height="22" Foreground="#9e9e9e" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                                                    <Image Source="{Binding Icon, Converter={StaticResource ByteToImageSourceConverter}}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- 账号名称与状态 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#212121"
                                                           MaxWidth="85"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />

                                                <!-- 真实账号显示游戏数量徽章 (需求: 账号要显示游戏数量) -->
                                                <Border Background="#ede7f6"
                                                        CornerRadius="3"
                                                        Padding="4,1"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding SteamId, Converter={StaticResource IsRealAccountConverter}}">
                                                    <TextBlock Text="{Binding GameCount, StringFormat='{}{0}'}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#673ab7" />
                                                </Border>


                                            </StackPanel>

                                            <!-- 真实账号显示账号名，所有游戏显示提示 -->
                                            <TextBlock FontSize="11" Foreground="#757575" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Account}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SteamId}" Value="{x:Static c:AppConstants.DefaultSteamId}">
                                                                <Setter Property="Text" Value="本机全部游戏" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 右侧操作区 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <!-- "所有游戏" 徽标 -->
                                            <Border CornerRadius="8" Background="#ede7f6" Padding="7,2"
                                                    Visibility="{Binding SteamId, Converter={StaticResource IsRealAccountConverter}, ConverterParameter=Inverse}">
                                                <TextBlock Text="{Binding DataContext.TotalGameCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="11" FontWeight="Bold" Foreground="#673ab7" />
                                            </Border>

                                            <!-- 真实账号【切换】按钮 -->
                                            <Button Style="{StaticResource SteamSwitchButtonStyle}"
                                                    Command="{Binding DataContext.SwitchSteamAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="直接切换至该 Steam 账号"
                                                    Padding="8,3"
                                                    Height="24"
                                                    Margin="0,0,4,0"
                                                    Visibility="{Binding SteamId, Converter={StaticResource IsRealAccountConverter}}">
                                                <TextBlock Text="切换" FontWeight="SemiBold" />
                                            </Button>

                                            <!-- 账号操作菜单按钮 (支持复制账号/密码、编辑、删除) -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Foreground="#757575"
                                                    ToolTip="账号操作"
                                                    Click="OpenContextMenu_Click"
                                                    Visibility="{Binding SteamId, Converter={StaticResource IsRealAccountConverter}}">
                                                <materialDesign:PackIcon Kind="DotsVertical" Width="16" Height="16" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource ModernContextMenuStyle}"
                                                                 DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="复制账号"
                                                                  Command="{Binding Path=CopySteamAccountCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                  CommandParameter="{Binding Account}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="#673ab7" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="复制密码"
                                                                  Command="{Binding Path=CopySteamPasswordCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                  CommandParameter="{Binding Password}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="KeyOutline" Width="14" Height="14" Foreground="#673ab7" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2" Background="#f1f5f9" />
                                                         <MenuItem Header="编辑账号"
                                                                  Command="{Binding Path=OpenEditSteamAccountDrawerCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="SquareEditOutline" Width="14" Height="14" Foreground="#3b82f6" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="隐藏账号"
                                                                  Visibility="{Binding IsHidden, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                                  Command="{Binding Path=ToggleHideSteamAccountCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                  CommandParameter="{Binding Account}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="EyeOffOutline" Width="14" Height="14" Foreground="#ef4444" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="取消隐藏"
                                                                  Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  Command="{Binding Path=ToggleHideSteamAccountCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                  CommandParameter="{Binding Account}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="EyeOutline" Width="14" Height="14" Foreground="#10b981" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 中间垂直分割线 -->
                    <Separator Grid.Column="1" Background="#e2e8f0" Margin="0" />

                    <!-- *************** 右侧：游戏库展示区 (白色主题) *************** -->
                    <Grid Grid.Column="2" Background="#fafafa">
                        <Grid.RowDefinitions>
                            <!-- 顶部操作栏 (52px) -->
                            <RowDefinition Height="52" />
                            <!-- 游戏网格内容区 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部工具栏 -->
                        <Grid Grid.Row="0" Background="#ffffff">
                            <!-- 视图标题 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="#212121" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding SelectedAccount.Name, StringFormat='{}{0}'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Static local:AppGlobalData.DefaultSteamAccount}">
                                                    <Setter Property="Text" Value="全部游戏" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="全部游戏" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Background="#ede7f6" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentAccountGameCount, StringFormat='共 {0} 款'}"
                                               FontSize="11"
                                               Foreground="#673ab7"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <!-- 右侧操作区：搜索框与隐藏项目切换 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBox Width="210"
                                         Height="34"
                                         Padding="8,6"
                                         FontSize="12"
                                         Foreground="#212121"
                                         Background="#ffffff"
                                         BorderBrush="#e0e0e0"
                                         materialDesign:TextFieldAssist.UnderlineBrush="#673ab7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="搜索游戏名称..."
                                         Text="{Binding SearchSteamGameName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:TextFieldAssist.HasClearButton="True" />

                                <!-- 切换显示已隐藏项目 -->
                                <ToggleButton IsChecked="{Binding ShowHidden}"
                                              ToolTip="显示已隐藏项目"
                                              Margin="10,0,0,0"
                                              Width="34" Height="34"
                                              Cursor="Hand"
                                              Style="{StaticResource MaterialDesignActionLightToggleButton}">
                                    <ToggleButton.Content>
                                        <materialDesign:PackIcon Kind="EyeOffOutline" Width="18" Height="18" Foreground="#94a3b8" />
                                    </ToggleButton.Content>
                                    <materialDesign:ToggleButtonAssist.OnContent>
                                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" Foreground="#673ab7" />
                                    </materialDesign:ToggleButtonAssist.OnContent>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <!-- 游戏卡片网格 -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SteamGames}"
                                 ItemContainerStyle="{StaticResource SteamGameListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="14,10">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 游戏海报大图卡片 (160 x 245，整个卡片背景为 Hero 大图) -->
                                    <Border Width="160"
                                            Height="245"
                                            Background="#1e293b"
                                            BorderBrush="#e2e8f0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.08" />
                                        </Border.Effect>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenSteamGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#8b5cf6" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#7c3aed" BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <!-- 1. 兜底深色底与占位图标 -->
                                            <materialDesign:PackIcon Kind="GamepadVariantOutline"
                                                                     Width="52"
                                                                     Height="52"
                                                                     Foreground="#475569"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />

                                            <!-- 2. 整个 Card 背景图：Steam 游戏大图 (Hero) -->
                                            <Image Source="{Binding Hero, Converter={StaticResource ByteToImageSourceConverter}}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- 3. 半透明暗色渐变蒙层，确保文字与按钮在任何背景下极具辨识度 -->
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#30000000" Offset="0" />
                                                        <GradientStop Color="#00000000" Offset="0.3" />
                                                        <GradientStop Color="#50000000" Offset="0.6" />
                                                        <GradientStop Color="#dd0f172a" Offset="0.82" />
                                                        <GradientStop Color="#fa0f172a" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- 3.5 已隐藏状态角标 -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                    Background="#cc0f172a" CornerRadius="4" Padding="5,2"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="EyeOffOutline" Width="12" Height="12" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                    <TextBlock Text="已隐藏" FontSize="10" FontWeight="SemiBold" Foreground="#cbd5e1" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 4. 内容布局 -->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- 上方主要展示与操作区 -->
                                                    <RowDefinition Height="*" />
                                                    <!-- 底部信息区 -->
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 悬停半透明遮罩 (启动大按钮) -->
                                                <Border x:Name="hoverOverlay"
                                                        Grid.Row="0"
                                                        Background="#77000000"
                                                        Opacity="0"
                                                        SnapsToDevicePixels="True">
                                                    <Button Style="{StaticResource SteamPlayButtonStyle}"
                                                            Command="{Binding DataContext.OpenSteamGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="105"
                                                            Height="36"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="启动" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Border>

                                                <!-- 卡片右上角操作菜单按钮 (置顶，悬停淡入) -->
                                                <Button x:Name="btnEditGame"
                                                        Grid.Row="0"
                                                        Panel.ZIndex="10"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        Foreground="#ffffff"
                                                        Background="#80000000"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,6,6,0"
                                                        Opacity="0"
                                                        ToolTip="游戏操作"
                                                        Click="OpenContextMenu_Click">
                                                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="16" Height="16" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource ModernContextMenuStyle}"
                                                                     DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="编辑游戏"
                                                                      Command="{Binding Path=OpenEditSteamGameDrawerCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="SquareEditOutline" Width="14" Height="14" Foreground="#3b82f6" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="隐藏游戏"
                                                                      Visibility="{Binding IsHidden, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                                      Command="{Binding Path=ToggleHideSteamGameCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                      CommandParameter="{Binding AppId}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="EyeOffOutline" Width="14" Height="14" Foreground="#ef4444" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="取消隐藏"
                                                                      Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                      Command="{Binding Path=ToggleHideSteamGameCommand, Source={x:Static manager:Lactor.MainViewModel}}"
                                                                      CommandParameter="{Binding AppId}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="EyeOutline" Width="14" Height="14" Foreground="#10b981" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>

                                                <!-- 底部信息条 (位于暗色渐变区上方) -->
                                                <Border Grid.Row="1" Padding="9,6,9,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- 游戏名称 -->
                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#ffffff"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"
                                                                   Margin="0,0,0,5">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.9" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>

                                                        <!-- 底部状态与账号选择 -->
                                                        <Grid Grid.Row="1">
                                                            <!-- 上次游玩时间 -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="ClockOutline" Width="11" Height="11" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                                <TextBlock Text="{Binding LastPlayed, Converter={StaticResource LastPlayedToTimeConverter}}"
                                                                           FontSize="10"
                                                                           Foreground="#cbd5e1"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- 选账号下拉切换 (仅在'所有游戏'视图下，且拥有关联账号时显示) -->
                                                            <Menu Background="Transparent"
                                                                  Tag="{Binding}"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center">
                                                                <Menu.Visibility>
                                                                    <MultiBinding Converter="{StaticResource GameAccountMenuVisibilityConverter}">
                                                                        <Binding Path="DataContext.SelectedAccount" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                        <Binding Path="AppId" />
                                                                    </MultiBinding>
                                                                </Menu.Visibility>
                                                                <MenuItem Style="{StaticResource GameAccountTopMenuItemStyle}"
                                                                          ItemsSource="{Binding AppId, Converter={StaticResource AppIdToAccountsConverter}}">
                                                                    <MenuItem.Header>
                                                                        <Border Background="#f5f3ff"
                                                                                BorderBrush="#ddd6fe"
                                                                                BorderThickness="1"
                                                                                CornerRadius="5"
                                                                                Padding="6,2"
                                                                                Cursor="Hand">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding Converter={StaticResource GameToAccountNameConverter}}"
                                                                                           MaxWidth="60"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           FontSize="11"
                                                                                           Foreground="#7c3aed"
                                                                                           FontWeight="SemiBold"
                                                                                           VerticalAlignment="Center" />
                                                                                <materialDesign:PackIcon Kind="MenuDown" Width="12" Height="12" Foreground="#7c3aed" VerticalAlignment="Center" Margin="1,0,0,0" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </MenuItem.Header>
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource GameAccountSubMenuItemStyle}">
                                                                            <Setter Property="Command" Value="{Binding Path=SelectGameAccountCommand, Source={x:Static manager:Lactor.MainViewModel}}" />
                                                                            <Setter Property="CommandParameter">
                                                                                <Setter.Value>
                                                                                    <MultiBinding Converter="{StaticResource ArrayMultiConverter}">
                                                                                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=Menu}" />
                                                                                        <Binding />
                                                                                    </MultiBinding>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="Header" Value="{Binding Name}" />
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                            </Menu>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="btnEditGame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="btnEditGame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </materialDesign:DrawerHost>

        <!-- 浮层通知 -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Center" />
    </Grid>
</Window>
